<xml>

	<include name="${HXCPP}/build-tool/BuildCommon.xml"/>

	<set name="mobile" value="1" if="iphone"/>
	<set name="mobile" value="1" if="android"/>
	<set name="mobile" value="1" if="blackberry"/>
	<set name="mobile" value="1" if="webos"/>

	<files id="common">
		<compilerflag value="-Ilua"/>
		<file name="common/ExternalInterface.cpp"/>
	</files>

	<set name="name_prefix" value="lib" if="iphone"/>
	<set name="ARM_ARCH" value="-v7" if="HXCPP_ARMV7"/>
	<set name="name_extra" value=".iphoneos${ARM_ARCH}" if="iphoneos"/>
	<set name="name_extra" value=".iphonesim" if="iphonesim"/>
	<set name="name_extra" value="-x86" if="simulator" unless="iphonesim" />
	<set name="tool" value="exe" unless="iphone"/>
	<set name="tool" value="static_link" if="iphone"/>
	<set name="ndll-tool" value="dll" unless="iphone"/>
	<set name="ndll-tool" value="static_link" if="iphone"/>
	<set name="SLIBEXT" value=".lib" if="windows"/>
	<set name="SLIBEXT" value=".a" unless="windows"/>
	<set name="SLIBEXT" value=".so" if="webos"/>

	<target id="NDLL" output="${name_prefix}hxlua${debug_extra}${name_extra}" tool="linker" toolid="${ndll-tool}">
		<outdir name="../ndll/${BINDIR}"/>
		<ext value=".ndll" unless="mobile"/>
		<files id="common"/>
		
        <section if="windows">
            <lib name='lua/lib/Windows64/lua51.lib' if='HXCPP_M64' />
            <lib name='lua/lib/Windows/lua51.lib' if='HXCPP_M32' />
        </section>
        <section if="linux">
            <lib name='lua/lib/Linux64/libluajit.so' if='HXCPP_M64' />
            <!-- <lib name='/lua/lib/Linux/libluajit.so' if='HXCPP_M32' /> -->
        </section>
        <section if="mac">
            <lib name='lua/lib/Mac/libluajit-5.1.a' if='HXCPP_M64' />
            <!-- <lib name='/lua/lib/Mac/libluajit-5.1.a' if='HXCPP_M32' /> -->
        </section>
        <section if="android">
            <lib name='lua/Android/libluajit-v7.so' if='HXCPP_ARMV7' />
            <lib name='lua/Android/libluajit-x86.so' if='HXCPP_X86' />
            <lib name='lua/Android/libluajit-64.so' if='HXCPP_ARM64' />
        </section>
	</target>

	<target id="default">
		<target id="NDLL"/>
	</target>

</xml>
